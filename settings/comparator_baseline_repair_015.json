    "legacy_event_window_csv": "docs/event_window_hydrology_series.csv",
    "legacy_full_window_csv": "docs/event_window_hydrology_series_2018_2024.csv"
  },
  "staging_paths": {
    "raw": "artifacts/comparator_baseline_repair_015/raw",
