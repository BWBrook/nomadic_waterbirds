    "summary_csv": "docs/pathrow_filtered_comparator_015_summary.csv",
    "comparison_csv": "docs/comparator_baseline_repair_015_comparison.csv",
    "denominator_effect_csv": "docs/legacy_denominator_effect_015.csv"
