  "source_product": "DEA Water Observations (Landsat)",
  "source_product_version": "ga_ls_wo_3 / 1-6-0 STAC metadata filtered to support-intersecting WRS path/rows",
  "metric_spec_version": "goal015-pathrow-filtered-comparator-v1",
  "scene_selection_policy": {
    "id": "support_intersecting_wrs_path_rows_only",
    "rule": "For support-level monthly Water Observations metrics, include only scenes from WRS-2 path/rows whose official footprints intersect the support geometry; do not count STAC bbox-only scenes outside that derived path/row set as readable scenes or invalid observations.",
    "support_pathrow_source": "docs/support_pathrow_crosswalk_013.csv",
    "fallback_if_stac_unavailable": "comparator_blocked_stac_unavailable"
  },
  "stac": {
    "search_url": "https://explorer.dea.ga.gov.au/stac/search",
    "limit": 20,
    "timeout_seconds": 30
  },
  "s3": {
    "bucket": "dea-public-data"
  },
  "comparison": {
    "fields": [
      "readable_scene_count",
      "clear_obs_count",
      "invalid_obs_count",
      "clear_obs_fraction",
      "current_wet_area_m2",
      "valid_support_area_m2",
      "current_proportion_wet",
      "wet_pixel_observation_count",
      "dry_pixel_observation_count",
      "quality_flag",
      "wet_month_flag"
    ],
    "tolerances": {
      "count_abs": 0.0,
      "fraction_abs": 0.000001,
      "area_m2_abs": 0.5,
      "numeric_abs": 0.0
    }
  },
  "inputs": {
    "goal013_manifest_json": "docs/support_pathrow_coverage_013_manifest.json",
    "goal013_crosswalk_csv": "docs/support_pathrow_crosswalk_013.csv",
    "goal013_item_sets_csv": "docs/support_pathrow_item_sets_013.csv",
